{
  "product": "joy",
  "name": "尚悦人生寿险计划 (LD2)",
  "signature": { "keywords": ["尚悅人生", "尚悦人生"] },
  "first_page": {
    "extractors": [
      { "fields": ["name", "gender"], "regex": "受保人姓名:\\s*(.+?)\\s+性別:\\s*(\\S+)" },
      { "fields": ["age", "smoking"], "regex": "年齡:\\s*(\\d+)\\s*吸煙狀況:\\s*(.+)" },
      { "fields": ["currency"], "regex": "保單貨幣:?\\s+(\\S+)" },
      { "fields": ["annual_premium"], "regex": "投保時每年總保費：\\s*([\\d,\\.]+)" },
      { "fields": ["levy"], "regex": "投保時徵費：\\s*([\\d,\\.]+)" },
      { "fields": ["premium_total"], "regex": "投保時保費及徵費總額：\\s*([\\d,\\.]+)" }
    ],
    "plan_row": { "mode": "joy", "code_re": "\\(LD\\w*\\)", "targets": ["sum_insured", "premium_term", "annual_premium_plan"] }
  },
  "variant": {
    "rules": [
      { "key": "wise", "keywords": ["特級計劃", "特级计划"] },
      { "key": "smart", "keywords": ["特選計劃", "特选计划"] }
    ]
  },
  "tables": {
    "years": {
      "page_hints": ["所有保單年"],
      "cash": { "cols": { "year": 0, "premiums": 1, "guaranteed": 2, "state_bonus": 3, "terminal": 4, "total": 5 } },
      "death": { "cols": { "year": 0, "premiums": 1, "guaranteed": 6, "state_bonus": 7, "terminal": 8, "total": 9 } }
    },
    "scenario": {
      "page_hints": ["不同投資回報下的說明"],
      "cash": {
        "title_kind": "現金價值",
        "cols": { "year": 0, "premiums": 1, "guaranteed": 2, "worst_state_bonus": 3, "worst_terminal": 4, "worst_total": 5, "best_state_bonus": 6, "best_terminal": 7, "best_total": 8 }
      },
      "death": {
        "title_kind": "身故保障",
        "cols": { "year": 0, "premiums": 1, "guaranteed": 2, "worst_state_bonus": 3, "worst_terminal": 4, "worst_total": 5, "best_state_bonus": 6, "best_terminal": 7, "best_total": 8 }
      }
    }
  },
  "key_periods": {
    "cash": ["10", "20", "25", "30", "65 歲", "75 歲", "80 歲", "100 歲"],
    "death": ["20", "65 歲", "70 歲", "75 歲", "80 歲", "90 歲", "100 歲"],
    "scenario": ["10", "20", "25", "30", "80 歲", "100 歲"]
  }
}