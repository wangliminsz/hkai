{
  "product": "GF",
  "name": "环宇盈活储蓄保险计划 (AIA)",
  "signature": {
    "keywords": [
      "環宇盈活",
      "环宇盈活",
      "友邦"
    ]
  },
  "first_page": {
    "extractors": [
      {
        "fields": [
          "name",
          "gender"
        ],
        "regex": "受保人姓名[:：]\\s*(.+?)\\s+年齡[:：]\\s*\\d+\\s+性別[:：]\\s*(\\S+)"
      },
      {
        "fields": [
          "age",
          "smoking"
        ],
        "regex": "年齡[:：]\\s*(\\d+)\\s+性別[:：]\\s*\\S+\\s*(\\S+)"
      },
      {
        "fields": [
          "smoking"
        ],
        "regex": "非吸煙者|吸煙者"
      },
      {
        "fields": [
          "currency"
        ],
        "regex": "保單貨幣[:：]\\s*(\\S+)"
      },
      {
        "fields": [
          "annual_premium"
        ],
        "regex": "投保時年繳總保費[:：]\\s*([\\d,\\.]+)"
      },
      {
        "fields": [
          "plan_name"
        ],
        "regex": "計劃[:：]\\s*(.+?)\\s*[（(]\\d+ 年繳費[）)]"
      },
      {
        "fields": [
          "premium_term"
        ],
        "regex": "[（(](\\d+) 年繳費[）)]"
      },
      {
        "fields": [
          "sum_insured"
        ],
        "regex": "\\|\\s*環宇盈活儲蓄保險計劃[^|]*\\|\\s*[\\d,\\.]+\\s*\\|\\s*([\\d,\\.]+)"
      }
    ],
    "plan_row": null
  },
