{
  "product": "pwl",
  "name": "尚裕终身寿险 Preeminence",
  "signature": { "keywords": ["尚裕", "PWL", "終身壽險", "终身寿险"] },
  "first_page": {
    "extractors": [
      { "fields": ["name", "gender"], "regex": "受保人姓名:\\s*(.+?)\\s+性別:\\s*(\\S+)" },
      { "fields": ["age", "smoking"], "regex": "年齡:\\s*(\\d+)\\s*吸煙狀況:\\s*(.+)" },
      { "fields": ["country_group"], "regex": "居住國家分類組別:\\s*(\\S+)" },
      { "fields": ["currency"], "regex": "保單貨幣:?\\s+(\\S+)" },
      { "fields": ["annual_premium"], "regex": "投保時每年總保費：\\s*([\\d,\\.]+)" },
      { "fields": ["levy"], "regex": "投保時徵費：\\s*([\\d,\\.]+)" },
      { "fields": ["premium_total"], "regex": "投保時保費及徵費總額：\\s*([\\d,\\.]+)" }
    ],
    "plan_row": { "mode": "pwl", "code_re": "PWL\\w*", "targets": ["sum_insured", "premium_term", "annual_premium_plan"] }
  },
  "tables": {
    "years": {
      "page_hints": ["所有保單年"],
      "cash": { "cols": { "year": 0, "premiums": 1, "guaranteed": 2, "terminal": 3, "total": 4 } },
      "death": { "cols": { "year": 0, "premiums": 1, "guaranteed": 5, "terminal": 6, "total": 7 } }
    },
    "scenario": {
      "page_hints": ["不同投資回報下的說明"],
      "cash": {
        "title_kind": "現金價值",
        "cols": { "year": 0, "premiums": 1, "guaranteed": 2, "worst_terminal": 3, "worst_total": 4, "best_terminal": 5, "best_total": 6 }
      },
      "death": {
        "title_kind": "身故保障",
        "cols": { "year": 0, "premiums": 1, "guaranteed": 2, "worst_terminal": 3, "worst_total": 4, "best_terminal": 5, "best_total": 6 }
      }
    }
  },
  "key_periods": {
    "cash": ["10", "20", "25", "30", "65 歲", "75 歲", "80 歲", "100 歲"],
    "death": ["20", "65 歲", "70 歲", "75 歲", "80 歲", "90 歲", "100 歲"],
    "scenario": ["10", "20", "25", "30", "80 歲", "100 歲"]
  }
}