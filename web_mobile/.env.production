ENV = 'production'
VITE_PUBLIC_PATH = /
# 生产环境：必须为空串/`/`，由 nginx 把 /api/ 反代到 Django。
# 千万不要写成 /api，否则请求会变成 /api/api/...
VITE_API_URL = ''
# 手机端未实现功能跳转到的电脑版地址
VITE_DESKTOP_URL = 'https://hkai.favor100.site'

# 品牌默认值（后端 /api/init/settings/ 有值时优先使用后端）
VITE_APP_TITLE = 'Hongkong HK'
VITE_APP_LOGO = '/db_trans.png'
VITE_APP_FAVICON = '/favicon.ico'
VITE_SIGN_IN_TEXT = '港险 AI 智慧系统'
