# ---------------------------------------------------------------------------
# hkins mobile frontend — nginx server block for mhkai.favor100.site
#
# Assumptions:
#   project dir      /home/hkai/app
#   mobile build     /home/hkai/app/web_mobile/dist
#   backend          gunicorn 127.0.0.1:8010 (hkins-web.service)
#
# The backend is NOT modified. To keep Django's ALLOWED_HOSTS unchanged
# (currently only hkai.favor100.site), the /api/ proxy overrides Host with
# hkai.favor100.site. If you prefer to add mhkai.favor100.site to
# ALLOWED_HOSTS in backend/conf/env.py, replace both Host lines with $host.
# ---------------------------------------------------------------------------

server {
    listen 80;
    server_name mhkai.favor100.site;

    root /home/hkai/app/web_mobile/dist;
    index index.html;

    client_max_body_size 50m;

    # gzip (keep this on; the mobile bundle is ~400KB JS + ~205KB CSS)
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml application/wasm;

    # hashed assets → long cache; index.html → never cache
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # RAG chat uses SSE; buffering must be off so tokens stream immediately.
    location /api/rag/ {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host hkai.favor100.site;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        client_max_body_size 50m;
    }

    # All other API calls (login, cards, docai, proposal, downloads…)
    location /api/ {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host hkai.favor100.site;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        client_max_body_size 50m;
    }

    location /static/ {
        alias /home/hkai/app/backend/staticfiles/;
    }

    # Only needed if branding/avatar uploads are served from /media/.
    location /media/ {
        alias /home/hkai/app/backend/media/;
    }

    # Hash router (/#/home) — this fallback is still useful for direct paths.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
