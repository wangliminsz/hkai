ENV = 'development'
VITE_PUBLIC_PATH = /
# 开发环境：同源请求，由 vite.config.ts 的 proxy 转发到 127.0.0.1:8000
VITE_API_URL = ''
VITE_DESKTOP_URL = 'http://localhost:8080'

# 品牌默认值（后端 /api/init/settings/ 有值时优先使用后端）
VITE_APP_TITLE = 'Hongkong HK'
VITE_APP_LOGO = '/db_trans.png'
VITE_APP_FAVICON = '/favicon.ico'
VITE_SIGN_IN_TEXT = '港险 AI 智慧系统'
